
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}

model Todo {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  dueDate     DateTime?
  topic       String    
  category    String?
  status      String  
  createdAt   DateTime  @default(now())
  archived    Boolean @default(false)
  updatedAt   DateTime @updatedAt
}
