
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Todo {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  dueDate     DateTime?
  topic       String    
  category    String?
  status      String  
  createdAt   DateTime  @default(now())
}
